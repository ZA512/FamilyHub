# Copiez ce fichier vers .env et remplacez toutes les valeurs « change-me ».
FAMILYHUB_VERSION=0.1.0
FAMILYHUB_IMAGE=ghcr.io/za512/familyhub
FAMILYHUB_PORT=3080
FAMILYHUB_ORIGIN=http://localhost:3080
FAMILYHUB_TIMEZONE=Europe/Paris
LOG_LEVEL=info

POSTGRES_DB=familyhub
POSTGRES_USER=familyhub
POSTGRES_PASSWORD=change-me-with-at-least-32-random-characters
# Utilisée par les commandes exécutées directement sur la machine de développement.
# Compose construit sa propre URL interne avec l'hôte `db`.
DATABASE_URL=postgresql://familyhub:change-me-with-at-least-32-random-characters@localhost:5432/familyhub

SESSION_SECRET=change-me-with-a-different-32-character-secret
SETUP_TOKEN=change-me-with-a-one-time-setup-token
SESSION_TTL_HOURS=720
TRUST_PROXY=false
MAX_UPLOAD_BYTES=26214400
ATTACHMENTS_DIR=/data/attachments
